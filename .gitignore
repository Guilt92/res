# Build output
/target/
/debug/
**/*.rs.bk
*.pdb

# Runtime state and local configuration
/config/res.credentials
/config/res.toml.backup
/config/.*.tmp
/.env
/.env.*
!/.env.example

# TLS material (test fixtures are exempt and clearly marked test-only)
*.pem
*.key
*.p12
*.pfx
!/tests/fixtures/tls/*.pem

# Logs, caches, coverage and benchmark output
*.log
*.tmp
*.bak
*.backup
*.swp
*.swo
*~
/bench/results/
/coverage/
/coverage.info
/tarpaulin-report.*
/mutants.out*/

# Python caches used by dashboard generation scripts
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
